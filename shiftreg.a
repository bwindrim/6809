        ; 6809+6522 VIA shift register setup.

            include "via6522.i"
            include "globals.i"

        ORG     $0000           ; This is a relocatable module.
        EXEC    init

        ; Output to shift register.
write:  begin
            pshs    y,d         ; Save Y (preserved) and D (return value) registers.
            tfr     d,y         ; Use Y as the length count.
            ; Loop over the bytes in the buffer, outputting to port A.
outer:      lda     ,x+         ; Get next byte.
            sta     sr       ; Output to shift register.
            ; Wait for "data shifted":
inner:      ldb     ifr         ; Load the Interrupt Flag Register.
            andb    #srflag    ; test CA1 (Port A Data Taken) flag.
            beq     inner       ; loop if not set.
            ; The byte has been output, continue.
            leay    -1,y        ; Decrement length.
            bne     outer       ; Loop if not zero.
            ; Done outputting, restore registers.
            puls    y,d,pc      ; Return, restoring Y and D.
        end

        ; Initialisation routine to set up shift register.
init:   begin
            leax    write,pcr   ; Copy the address of the shift register output routine
            stx     g_shiftout  ; to the shift register vector
            lda     acr         ; Read 6522 Auxiliary Control Register.
            anda    #ACR_SHIFT_MASK ; Clear bits 2,3,4 for shift register mode.
            ora     #SHIFT_OUT_PHI2    ; Set shift register to output mode.
            sta     acr         ; Store back to ACR.
            rts                 ; Done, return to the loader.
        end
