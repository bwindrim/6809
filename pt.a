
PT_WAITING      equ         0
PT_YIELDED      equ         1
PT_EXITED       equ         2
PT_ENDED        equ         3

PT_YIELD_FLAG   equ         0       ; frame offset for PT_YIELD_FLAG

PT_INIT         macro       name
                    leay     ?name.start,pcr
                    sty     0,x
                endm

PT_BEGIN        macro       name
?name                       begin
                    pshs    u       ; save prev frame ptr
                    tfr     s,u     ; copy stack ptr to frame ptr
                    leas    -2,s    ; allocate stack frame (1 byte)
                    lda     #1
                    sta     PT_YIELD_FLAG,u
                    jmp     [,x]
start:
                endm

PT_END          macro
                    lda     #0      ; PT_YIELD_FLAG = 0
                    sta     PT_YIELD_FLAG,u
                    leay    .start,pcr
                    sty     0,x
                    tfr     u,s     ; copy frame ptr back to stack ptr
                    lda     #PT_ENDED
                    puls    u       ; restore prev frame ptr
                    rts             ; return
                    end
                endm

task1:          dw  0
task2:          dw  0

                leax    task1,pcr
                PT_INIT     task
                leax    task2,pcr
                PT_INIT     task

                PT_BEGIN    task
                PT_END
