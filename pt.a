
PT_WAITING      equ         0
PT_YIELDED      equ         1
PT_EXITED       equ         2
PT_ENDED        equ         3

PT_INIT         macro       name
                    leay     ?name.start,pcr
                    sty     ,x
                endm

PT_BEGIN        macro       name
?name                       begin
                    jmp     [,x]
start:
                endm

PT_END          macro
                    leay    .start,pcr
                    sty     ,x
                    lda     #PT_ENDED
                    rts             ; return
                    end
                endm

PT_YIELD        macro
                begin
                leay        .continue,pcr
                sty         ,x
                lda         #PT_YIELDED
                rts
continue:
                end
                endm

task1:          dw  0
task2:          dw  0

                leax    task1,pcr
                PT_INIT     task
                leax    task2,pcr
                PT_INIT     task

                PT_BEGIN    task
loop:           PT_YIELD
                bra         loop
                PT_END
