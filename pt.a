
                include "pt.i"
                
                ORG     $0000
                EXEC    main

                ; Test task.
                PT_BEGIN    task
loop:           PT_YIELD
                bra         loop
                PT_END

                ; Task instances.
task1:          dw  0
task2:          dw  0

                ; Main function.
main:           begin
                leax    task1,pcr
                PT_INIT     task
                leax    task2,pcr
                PT_INIT     task
loop:           ; Executor loop.
                leax        task1,pcr
                bsr         task.run
                leax        task2,pcr
                bsr         task.run
                bra         loop
                end

